# Official AzeForge TeX renderer. Build only on Linux/amd64 with a locally
# retained tex-renderer/texlive2026.iso verified by its accompanying checksum.
FROM ubuntu@sha256:496754492fb28b4d3049432f2ca787449331e23fb14f0dd3fffea86bf5a93eb4 AS installer

RUN test "$(dpkg --print-architecture)" = amd64
# The installer utilities never enter the runtime image. Their complete
# version closure is locked so an archive change fails the build rather than
# silently changing the TeX installation process.
COPY tex-renderer/installer-packages.lock /tmp/installer-packages.lock
RUN set -eu; \
    apt-get update; \
    awk '{ printf "%s=%s ", $1, $2 }' /tmp/installer-packages.lock | xargs apt-get install --no-install-recommends -y; \
    awk '{ print $1 }' /tmp/installer-packages.lock | xargs dpkg-query -W -f='${binary:Package} ${Version}\n' | LC_ALL=C sort > /tmp/installer-packages.actual; \
    diff -u /tmp/installer-packages.lock /tmp/installer-packages.actual; \
    rm -rf /var/lib/apt/lists/*
COPY tex-renderer/texlive2026.iso /tmp/texlive2026.iso
COPY tex-renderer/texlive.profile tex-renderer/package-closure.lock /tmp/
RUN printf '%s  %s\n' '4a9071bb567c3bdd6443378dedc8e485aea4a2f1203ec8ed7c17f6787093b9c37636a037032c0be63352e3d0bf98cf5616dab19fdcd7cb83f766b3e085b620ff' /tmp/texlive2026.iso | sha512sum --check --strict
RUN mkdir /iso /texlive \
 && xorriso -osirrox on -indev /tmp/texlive2026.iso -extract / /iso \
 && test -s /iso/tlpkg/texlive.tlpdb \
 && test -s /iso/tlpkg/texlive.tlpdb.sha512
RUN /iso/install-tl --profile /tmp/texlive.profile
# The verified ISO supplies TeX Live's repository metadata. Use a canonical
# file URI so tlmgr reads that local repository without network fallback.
RUN set -x \
 && /texlive/bin/*/tlmgr --repository file:///iso --verify-repo=main install latex latex-bin graphics xcolor amsmath pgf circuitikz pgfplots chemfig simplekv tikz-cd xstring lm cm amsfonts dvisvgm \
 && echo "--- TeX Live configuration" \
 && /texlive/bin/*/tlmgr conf
RUN set -eu; \
    awk -F': ' '/failed install:/ { print $2 }' /texlive/texmf-var/web2c/tlmgr.log | LC_ALL=C sort -u | while IFS= read -r package; do \
      set -- /iso/archive/"$package".r*.tar.xz; \
      test -s "$1"; \
      /texlive/bin/*/tlmgr install --file "$1"; \
    done
RUN awk '/^name / { name = $2; next } /^revision / { if (name != "") print name, $2; name = "" }' /texlive/tlpkg/texlive.tlpdb \
 | LC_ALL=C sort > /texlive/packages.txt \
 && test -s /texlive/packages.txt \
 && diff -u /tmp/package-closure.lock /texlive/packages.txt
RUN sha256sum /texlive/tlpkg/texlive.tlpdb > /texlive/tlpdb.sha256 \
 && /texlive/bin/*/mktexlsr \
 && /texlive/bin/*/fmtutil-sys --all

FROM ubuntu@sha256:496754492fb28b4d3049432f2ca787449331e23fb14f0dd3fffea86bf5a93eb4
RUN test "$(dpkg --print-architecture)" = amd64
COPY --from=installer /texlive /opt/texlive
COPY tex-renderer/entrypoint.sh /usr/local/bin/azeforge-tex-renderer
# The runtime needs neither OS nor TeX package management. Removing both
# prevents a privileged launch override from mutating the frozen closure.
RUN useradd --system --uid 10001 --home /nonexistent --shell /usr/sbin/nologin renderer \
 && rm -rf /etc/apt /usr/lib/apt /var/cache/apt /var/lib/apt /var/lib/dpkg \
 && rm -f /usr/bin/apt* /usr/bin/dpkg* /usr/sbin/dpkg* \
 && test ! -e /usr/bin/apt-get \
 && test ! -e /usr/bin/dpkg \
 && find /opt/texlive \( -type f -o -type l \) -name 'tlmgr*' -delete \
 && test -z "$(find /opt/texlive \( -type f -o -type l \) -name 'tlmgr*' -print -quit)" \
 && chmod -R a-w /opt/texlive \
 && chmod 0555 /usr/local/bin/azeforge-tex-renderer
ENV PATH=/opt/texlive/bin/x86_64-linux:$PATH
USER renderer
ENTRYPOINT ["/usr/local/bin/azeforge-tex-renderer"]
