{
  "name": "@aruzone/aze-forge",
  "version": "0.1.1",
  "description": "Deterministic AzeMark compiler: readable source in, self-contained HTML, SVG, PNG, and PDF artifacts out.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aruzone/aze-forge.git"
  },
  "keywords": [
    "azemark",
    "markdown",
    "publishing",
    "pdf",
    "svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "azeforge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "docs/assets/azeforge-logo-03-2.jpg"
  ],
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build --silent",
    "test": "npm run build --silent && node --test test/*.test.mjs",
    "test:matrix": "node --test --test-reporter=tap test/capabilities.test.mjs test/cli.test.mjs test/compatibility.test.mjs test/compiler.test.mjs test/equation.test.mjs test/fail-closed.test.mjs test/format.test.mjs test/installed-cli.test.mjs test/schemas.test.mjs test/theme-assets.test.mjs test/watch-serve.test.mjs",
    "test:browser-smoke": "node --test --test-reporter=tap test/browser-smoke.test.mjs",
    "test:canonical": "node scripts/acceptance.mjs --json",
    "test:canonical-suite": "node --test --test-reporter=tap test/acceptance.test.mjs test/mermaid.test.mjs test/pdf.test.mjs test/png.test.mjs test/svg.test.mjs",
    "test:compiler": "npm run build --silent && node --test test/compiler.test.mjs",
    "test:cli": "npm run build --silent && node --test test/cli.test.mjs",
    "test:acceptance": "npm run build --silent && node --test test/acceptance.test.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "acceptance:refresh": "node scripts/acceptance.mjs --refresh"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@puppeteer/browsers": "3.2.2",
    "katex": "0.18.5",
    "mermaid": "11.17.2",
    "puppeteer": "25.10.0",
    "puppeteer-core": "25.10.0",
    "saxes": "6.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  },
  "allowScripts": {
    "puppeteer@25.10.0": true
  }
}
