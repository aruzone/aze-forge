node_modules/
# dist/ is committed: a Git-spec install (`npm install -g aruzone/aze-forge`)
# cannot build, because npm's git-dependency preparation installs no
# devDependencies. The registry tarball is rebuilt by prepublishOnly.
*.tmp
.DS_Store
# Release evidence and refreshed baselines written by scripts/*-release.sh
# (`artifacts/`); review-only output, never committed.
artifacts/

# Downloaded separately; Dockerfile.tex-renderer verifies its pinned SHA-512.
tex-renderer/texlive2026.iso
